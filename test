-- Discord Tracker (только владелец скрипта)
local webhook = g
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local function sendToDiscord(data)
    local headers = {["Content-Type"] = "application/json"}
    local body = HttpService:JSONEncode(data)
    pcall(function()
        request({Url = webhook, Method = "POST", Headers = headers, Body = body})
    end)
end

local function formatTime()
    local t = os.date("!*t", os.time())
    return string.format("%02d:%02d:%02d %02d.%02d.%04d", t.hour, t.min, t.sec, t.day, t.month, t.year)
end

local function getGameInfo()
    return {
        name = game.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        players = #Players:GetPlayers()
    }
end

-- Информация о сервере при запуске (со ссылкой)
local function sendStartupInfo()
    wait(3)
    local gameInfo = getGameInfo()
    local players = Players:GetPlayers()
    local playerNames = {}
    for _, p in ipairs(players) do
        table.insert(playerNames, p.Name)
    end
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "🟢 **Сервер запущен**",
        description = string.format(
            "**🎮 Игра:** `%s`\n**🆔 Place ID:** `%d`\n**🔗 Server ID:** `%s`\n**👥 Игроков:** `%d`\n\n**🌍 Ссылка на сервер:** [Нажми чтобы зайти](%s)\n\n**📋 Список игроков:**\n`%s`\n\n**⏱ Время:** `%s` (UTC+0)",
            gameInfo.name, gameInfo.placeId, gameInfo.jobId, gameInfo.players, serverLink, table.concat(playerNames, ", "), formatTime()
        ),
        color = 0x44ff44
    }}

    sendToDiscord({embeds = embed, username = "Roblox Tracker"})
end

-- Отправка когда владелец вышел
local function sendLeaveMessage()
    local gameInfo = getGameInfo()
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "🚪 **Вышел из сервера**",
        description = string.format(
            "**Игрок:** `%s` (@%s)\n**ID:** `%d`\n**Время выхода:** `%s` (UTC+0)\n\n**🔗 Ссылка на сервер:** [Нажми чтобы зайти](%s)\n\n**📊 Сервер:** `%s`\n**Игроков осталось:** `%d`\n**Place ID:** `%d`",
            LocalPlayer.Name, LocalPlayer.DisplayName, LocalPlayer.UserId, formatTime(), serverLink, gameInfo.name, gameInfo.players - 1, gameInfo.placeId
        ),
        color = 0xff4444
    }}

    sendToDiscord({embeds = embed, username = "Roblox Tracker"})
end

-- Периодическая информация
local function sendServerInfo()
    local gameInfo = getGameInfo()
    local players = Players:GetPlayers()
    local playerList = {}
    for i, p in ipairs(players) do
        table.insert(playerList, string.format("%d. %s", i, p.Name))
    end
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "📡 **Информация о сервере**",
        description = string.format(
            "**🎮 Игра:** `%s`\n**🆔 Place ID:** `%d`\n**👥 Игроков:** `%d`\n\n**🌍 Ссылка:** [Нажми](%s)\n\n**📋 Список игроков:**\n`%s`",
            gameInfo.name, gameInfo.placeId, gameInfo.players, serverLink, table.concat(playerList, ", ")
        ),
        color = 0x3399ff
    }}

    sendToDiscord({embeds = embed, username = "Roblox Tracker"})
end

-- Запуск
local function init()
    print("[Discord Tracker] Загружен | Отслеживается: " .. LocalPlayer.Name)
    
    sendStartupInfo()
    
    game:BindToClose(function()
        sendLeaveMessage()
        wait(1)
    end)
    
    spawn(function()
        while true do
            wait(1800)
            sendServerInfo()
        end
    end)
end

init()