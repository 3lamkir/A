-- Discord Tracker Pro (с авторегионом)
local webhook = g
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- Определение региона
local region = {country = "Unknown", timezone = "UTC", utc_offset = "+00:00", country_code = "🌍"}

pcall(function()
    local response = game:HttpGet("https://ipapi.co/json/")
    local data = HttpService:JSONDecode(response)
    region.country = data.country_name or "Unknown"
    region.country_code = data.country_code or "??"
    region.city = data.city or "Unknown"
    region.timezone = data.timezone or "UTC"
    region.utc_offset = data.utc_offset or "+00:00"
end)

local function getFlagEmoji(code)
    local flags = {RU="🇷🇺",US="🇺🇸",GB="🇬🇧",DE="🇩🇪",FR="🇫🇷",UA="🇺🇦",BY="🇧🇾",KZ="🇰🇿",PL="🇵🇱",NL="🇳🇱"}
    return flags[code] or "🌍"
end

local function formatLocalTime()
    local t = os.date("!*t", os.time())
    local offset = tonumber(region.utc_offset:match("[+-]%d+")) or 0
    local hour = (t.hour + offset) % 24
    return string.format("%02d:%02d:%02d %02d.%02d.%04d", hour, t.min, t.sec, t.day, t.month, t.year)
end

local function formatShortTime()
    local t = os.date("!*t", os.time())
    local offset = tonumber(region.utc_offset:match("[+-]%d+")) or 0
    local hour = (t.hour + offset) % 24
    return string.format("%02d:%02d:%02d", hour, t.min, t.sec)
end

-- Отправка
local function sendToDiscord(embeds)
    local data = {embeds = embeds, username = string.format("%s Roblox Tracker", getFlagEmoji(region.country_code))}
    local headers = {["Content-Type"] = "application/json"}
    pcall(function()
        request({Url = webhook, Method = "POST", Headers = headers, Body = HttpService:JSONEncode(data)})
    end)
end

local function getGameInfo()
    return {
        name = game.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        players = #Players:GetPlayers(),
        ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString())
    }
end

local function getPlayerList()
    local players = Players:GetPlayers()
    local result = {}
    for _, p in ipairs(players) do
        table.insert(result, (p == LocalPlayer and "👑 " or "👤 ") .. p.Name)
    end
    table.sort(result)
    return result
end

-- Запуск (мгновенно)
local function sendStartupInfo()
    local gameInfo = getGameInfo()
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId
    
    local embed = {
        title = string.format("%s **СЕРВЕР ЗАПУЩЕН** %s", getFlagEmoji(region.country_code), getFlagEmoji(region.country_code)),
        description = string.format(
            "```\n🎮 %s\n🆔 %d\n🖥️ %s\n👥 %d игроков\n📶 %d ms\n📍 %s, %s\n```\n\n**🔗 Ссылка:** [Нажми чтобы зайти](%s)\n\n**📋 Игроки:**\n%s",
            gameInfo.name, gameInfo.placeId, gameInfo.jobId, gameInfo.players, gameInfo.ping,
            region.city, region.country,
            serverLink, table.concat(getPlayerList(), "\n")
        ),
        color = 0x2ecc71,
        footer = {text = string.format("🕐 %s (%s %s)", formatShortTime(), region.timezone, region.utc_offset)},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    sendToDiscord({embed})
end

-- Выход
local function sendLeaveMessage()
    local gameInfo = getGameInfo()
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId
    
    local embed = {
        title = "❌ **ВЫХОД С СЕРВЕРА** ❌",
        description = string.format(
            "```\n👤 %s\n🆔 %d\n👥 Осталось: %d игроков\n📍 %s, %s\n```\n\n**🔗 Ссылка:** [Вернуться](%s)",
            LocalPlayer.Name, LocalPlayer.UserId, gameInfo.players - 1, region.city, region.country, serverLink
        ),
        color = 0xe74c3c,
        footer = {text = string.format("🕐 %s (%s)", formatShortTime(), region.timezone)},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    sendToDiscord({embed})
end

-- Периодическое обновление
local function sendServerUpdate()
    local gameInfo = getGameInfo()
    local embed = {
        title = "📡 **СТАТУС СЕРВЕРА** 📡",
        description = string.format(
            "```\n🎮 %s\n👥 %d игроков\n📶 %d ms\n🆔 %s\n📍 %s, %s\n```\n\n**📋 Онлайн:**\n%s",
            gameInfo.name, gameInfo.players, gameInfo.ping, gameInfo.jobId:sub(1, 12).."...",
            region.city, region.country, table.concat(getPlayerList(), "\n")
        ),
        color = 0x3498db,
        footer = {text = string.format("🕐 %s | Обновление", formatShortTime())},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    sendToDiscord({embed})
end

-- Запуск
local startTime = os.time()
sendStartupInfo()

game:BindToClose(function()
    sendLeaveMessage()
    wait(1)
end)

spawn(function()
    while true do
        wait(900)
        sendServerUpdate()
    end
end)

print("[Tracker] Загружен | Регион: " .. region.country .. " (" .. region.timezone .. ")")