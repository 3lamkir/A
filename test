-- Discord Tracker (кастом)
local webhook = g
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local config = {
    sendJoins = true,
    sendLeaves = true,
    sendGameInfo = true,
    botName = "Roblox Tracker"
}

local function sendToDiscord(data)
    local headers = {["Content-Type"] = "application/json"}
    local body = HttpService:JSONEncode(data)
    pcall(function()
        request({Url = webhook, Method = "POST", Headers = headers, Body = body})
    end)
end

local function formatTime()
    local t = os.date("!*t", os.time())
    return string.format("%02d:%02d:%02d %02d.%02d.%04d", t.hour, t.min, t.sec, t.day, t.month, t.year)
end

local function getGameInfo()
    return {
        name = game.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        players = #Players:GetPlayers(),
        maxPlayers = Players.MaxPlayers
    }
end

local function getPlayerInfo(player)
    return {
        name = player.Name,
        displayName = player.DisplayName,
        userId = player.UserId,
        accountAge = math.floor((os.time() - player.AccountAge) / 86400)
    }
end

-- Отправка когда игрок (использующий скрипт) вышел
local function sendLeaveMessage()
    local info = getPlayerInfo(LocalPlayer)
    local gameInfo = getGameInfo()
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "🚪 **Вышел из сервера**",
        description = string.format(
            "**Игрок:** `%s` (@%s)\n**ID:** `%d`\n**Время выхода:** `%s` (UTC+0)\n\n**🔗 Ссылка на сервер:** [Нажми чтобы зайти](%s)\n\n**📊 Сервер:** `%s`\n**Игроков осталось:** `%d`\n**Place ID:** `%d`",
            info.name, info.displayName, info.userId, formatTime(), serverLink, gameInfo.name, gameInfo.players - 1, gameInfo.placeId
        ),
        color = 0xff4444,
        footer = {text = "Tracker by @" .. LocalPlayer.Name},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }}

    sendToDiscord({embeds = embed, username = config.botName})
end

-- Информация о сервере при запуске
local function sendStartupInfo()
    wait(3)
    local gameInfo = getGameInfo()
    local players = Players:GetPlayers()
    local playerNames = {}
    for _, p in ipairs(players) do
        table.insert(playerNames, p.Name)
    end
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "🟢 **Сервер запущен**",
        description = string.format(
            "**🎮 Игра:** `%s`\n**🆔 Place ID:** `%d`\n**🔗 Server ID:** `%s`\n**👥 Игроков:** `%d`\n**🌍 Ссылка:** [Клик чтобы зайти](%s)\n\n**📋 Список игроков:**\n`%s`\n\n**⏱ Время запуска:** `%s` (UTC+0)",
            gameInfo.name, gameInfo.placeId, gameInfo.jobId, gameInfo.players, serverLink, table.concat(playerNames, ", "), formatTime()
        ),
        color = 0x44ff44,
        footer = {text = "Tracker by @" .. LocalPlayer.Name},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }}

    sendToDiscord({embeds = embed, username = config.botName})
end

-- Периодическая информация о сервере
local function sendServerInfo()
    local gameInfo = getGameInfo()
    local players = Players:GetPlayers()
    local playerList = {}
    for i, p in ipairs(players) do
        table.insert(playerList, string.format("%d. %s", i, p.Name))
    end
    local serverLink = "https://www.roblox.com/games/" .. gameInfo.placeId .. "?server=" .. gameInfo.jobId

    local embed = {{
        title = "📡 **Информация о сервере**",
        description = string.format(
            "**🎮 Игра:** `%s`\n**🆔 Place ID:** `%d`\n**👥 Игроков:** `%d`\n**🌍 Ссылка:** [Клик](%s)\n\n**📋 Список игроков:**\n`%s`",
            gameInfo.name, gameInfo.placeId, gameInfo.players, serverLink, table.concat(playerList, ", ")
        ),
        color = 0x3399ff,
        footer = {text = "Tracker by @" .. LocalPlayer.Name},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }}

    sendToDiscord({embeds = embed, username = config.botName})
end

-- Инициализация
local function init()
    print("[Discord Tracker] Загружен | Отслеживается игрок: " .. LocalPlayer.Name)

    if config.sendLeaves then
        game:BindToClose(function()
            sendLeaveMessage()
            wait(1)
        end)
    end

    sendStartupInfo()

    spawn(function()
        while true do
            wait(1800)
            if config.sendGameInfo then
                sendServerInfo()
            end
        end
    end)
end

init()