-- Discord Tracker (Рабочая версия)
local webhook = g
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- Регион (с защитой)
local region = {
    country = "Unknown",
    city = "Unknown",
    timezone = "UTC",
    flag = "🌍"
}

pcall(function()
    local response = game:HttpGet("https://ipapi.co/json/")
    local data = HttpService:JSONDecode(response)
    if data then
        region.country = data.country_name or "Unknown"
        region.city = data.city or "Unknown"
        region.timezone = data.timezone or "UTC"
        local flags = {RU="🇷🇺", US="🇺🇸", GB="🇬🇧", DE="🇩🇪", FR="🇫🇷"}
        region.flag = flags[data.country_code] or "🌍"
    end
end)

-- Время
local function getTime()
    local t = os.date("*t")
    return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

-- Отправка в Discord
local function sendEmbed(title, description, color)
    local embed = {
        title = title,
        description = description,
        color = color,
        footer = {text = getTime() .. " | " .. region.timezone},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    local data = {
        embeds = {embed},
        username = region.flag .. " Roblox Tracker"
    }
    pcall(function()
        request({
            Url = webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- Информация об игре
local function getGameInfo()
    local pingStr = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
    local ping = tonumber(pingStr) or 0
    return {
        name = tostring(game.Name),
        placeId = tostring(game.PlaceId),
        jobId = tostring(game.JobId),
        players = #Players:GetPlayers(),
        ping = math.floor(ping)
    }
end

-- Список игроков
local function getPlayerNames()
    local names = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then
            table.insert(names, "👑 " .. p.Name)
        else
            table.insert(names, "👤 " .. p.Name)
        end
    end
    table.sort(names)
    return table.concat(names, "\n")
end

-- Запуск сервера
local function sendStartup()
    local info = getGameInfo()
    local link = "https://www.roblox.com/games/" .. info.placeId .. "?server=" .. info.jobId
    
    local desc = string.format([[
**🎮 Игра:** %s
**🆔 Place ID:** %s
**🖥️ Server ID:** %s
**👥 Игроков:** %d
**📶 Пинг:** %d ms
**📍 Регион:** %s, %s

**🔗 Ссылка:** [Нажми чтобы зайти](%s)

**📋 Игроки:**
%s
]], info.name, info.placeId, info.jobId, info.players, info.ping, region.city, region.country, link, getPlayerNames())
    
    sendEmbed("🟢 СЕРВЕР ЗАПУЩЕН", desc, 0x2ecc71)
end

-- Выход
local function sendLeave()
    local info = getGameInfo()
    local link = "https://www.roblox.com/games/" .. info.placeId .. "?server=" .. info.jobId
    
    local desc = string.format([[
**👤 Игрок:** %s
**🆔 ID:** %d
**👥 Осталось:** %d игроков
**📍 Регион:** %s, %s

**🔗 Ссылка:** [Вернуться](%s)
]], LocalPlayer.Name, LocalPlayer.UserId, info.players - 1, region.city, region.country, link)
    
    sendEmbed("🔴 ВЫХОД С СЕРВЕРА", desc, 0xe74c3c)
end

-- Обновление статуса
local function sendUpdate()
    local info = getGameInfo()
    
    local desc = string.format([[
**🎮 Игра:** %s
**👥 Игроков:** %d
**📶 Пинг:** %d ms
**📍 Регион:** %s, %s

**📋 Онлайн:**
%s
]], info.name, info.players, info.ping, region.city, region.country, getPlayerNames())
    
    sendEmbed("📡 СТАТУС СЕРВЕРА", desc, 0x3498db)
end

-- Запуск
sendStartup()

game:BindToClose(function()
    sendLeave()
    wait(1)
end)

spawn(function()
    while true do
        wait(900)
        sendUpdate()
    end
end)

print("[Tracker] Загружен | " .. LocalPlayer.Name .. " | " .. region.country)