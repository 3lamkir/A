-- Discord Tracker (Простая версия)
local webhook = g
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- Время
local function getTime()
    local t = os.date("*t")
    return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

-- Отправка в Discord
local function sendEmbed(title, description, color)
    local embed = {
        title = title,
        description = description,
        color = color,
        footer = {text = getTime()},
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    local data = {
        embeds = {embed},
        username = "Roblox Tracker"
    }
    pcall(function()
        request({
            Url = webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- Информация об игре
local function getGameInfo()
    local pingStr = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
    local ping = tonumber(pingStr) or 0
    return {
        name = game.Name,
        placeId = game.PlaceId,
        jobId = game.JobId,
        players = #Players:GetPlayers(),
        ping = math.floor(ping)
    }
end

-- Список игроков
local function getPlayerNames()
    local names = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then
            table.insert(names, "👑 " .. p.Name)
        else
            table.insert(names, "👤 " .. p.Name)
        end
    end
    table.sort(names)
    return table.concat(names, "\n")
end

-- Запуск сервера
local function sendStartup()
    local info = getGameInfo()
    local link = "https://www.roblox.com/games/" .. info.placeId .. "?server=" .. info.jobId
    
    local desc = string.format([[
**Игра:** %s
**Place ID:** %d
**Server ID:** %s
**Игроков:** %d
**Пинг:** %d ms

**Ссылка:** [Нажми чтобы зайти](%s)

**Игроки:**
%s
]], info.name, info.placeId, info.jobId, info.players, info.ping, link, getPlayerNames())
    
    sendEmbed("🟢 СЕРВЕР ЗАПУЩЕН", desc, 0x2ecc71)
end

-- Выход
local function sendLeave()
    local info = getGameInfo()
    local link = "https://www.roblox.com/games/" .. info.placeId .. "?server=" .. info.jobId
    
    local desc = string.format([[
**Игрок:** %s
**ID:** %d
**Осталось игроков:** %d

**Ссылка:** [Вернуться](%s)
]], LocalPlayer.Name, LocalPlayer.UserId, info.players - 1, link)
    
    sendEmbed("🔴 ВЫХОД С СЕРВЕРА", desc, 0xe74c3c)
end

-- Обновление статуса
local function sendUpdate()
    local info = getGameInfo()
    
    local desc = string.format([[
**Игра:** %s
**Игроков:** %d
**Пинг:** %d ms

**Онлайн:**
%s
]], info.name, info.players, info.ping, getPlayerNames())
    
    sendEmbed("📡 СТАТУС СЕРВЕРА", desc, 0x3498db)
end

-- Запуск
sendStartup()

game:BindToClose(function()
    sendLeave()
    wait(1)
end)

spawn(function()
    while true do
        wait(10)
        sendUpdate()
    end
end)

print("[Tracker] Загружен | " .. LocalPlayer.Name)